<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:locator="clr-namespace:Maui.Features"
             xmlns:vm="clr-namespace:Maui.Core.Features.Debug;assembly=Maui.Core"
             x:Class="Maui.Features.Debug.ViewStates.ViewStatesPage"
             Title="View States">
    <ContentPage.BindingContext>
        <locator:Locator ViewModelType="{x:Type vm:ViewStatesPageModel}" />
    </ContentPage.BindingContext>
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <Label
                Text="View States"
                FontSize="24"
                FontAttributes="Bold" />

            <Label
                Text="Test different visual states of your views"
                FontSize="14"
                TextColor="Gray" />

            <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />

            <!-- List of available view states -->
            <VerticalStackLayout Spacing="10">
                <Button
                    Text="SyncStatus States"
                    Command="{Binding GoToSyncStatusCommand}"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
