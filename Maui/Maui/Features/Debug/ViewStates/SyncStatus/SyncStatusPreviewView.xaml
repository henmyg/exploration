<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:locator="clr-namespace:Maui.Features"
             xmlns:vm="clr-namespace:Maui.Core.Features.Debug;assembly=Maui.Core"
             xmlns:syncStatusVm="clr-namespace:Maui.Core.Features.SyncStatus;assembly=Maui.Core"
             xmlns:viewStates="clr-namespace:Maui.Features.Debug.ViewStates"
             xmlns:syncStatusView="clr-namespace:Maui.Features.SyncStatus"
             x:Class="Maui.Features.Debug.ViewStates.SyncStatus.SyncStatusPreviewView"
             x:DataType="vm:MockSyncStatusViewModel">
    <ContentView.BindingContext>
        <locator:Locator ViewModelType="{x:Type vm:MockSyncStatusViewModel}" />
    </ContentView.BindingContext>
    <ContentView.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <viewStates:PreviewTemplate />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentView.Resources>
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <ContentView
                ControlTemplate="{StaticResource Test}">
                <syncStatusView:SyncStatusView BindingContext="{Binding}" />
            </ContentView>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
