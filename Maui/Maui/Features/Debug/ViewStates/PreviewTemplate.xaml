<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Maui.Core.Features.Debug;assembly=Maui.Core"                
    x:Class="Maui.Features.Debug.ViewStates.PreviewTemplate">
    <ControlTemplate x:Key="PreviewView">
        <ContentView BindingContext="{TemplateBinding BindingContext}">
            <VerticalStackLayout>
                <Label
                     Text="SyncStatus View States"
                     FontSize="24"
                     FontAttributes="Bold" />

                <Label
                     Text="Use the radio buttons to switch between states and see transitions"
                     FontSize="14"
                     TextColor="Gray" />

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />

                <!-- State Selector -->
                <Label Text="Select State:" FontSize="16" FontAttributes="Bold" Margin="0,10,0,5" />

                <HorizontalStackLayout
                    Spacing="20"
                    HorizontalOptions="Center"
                    RadioButtonGroup.GroupName="StateSelector"
                    BindableLayout.ItemsSource="{Binding States}"
                    RadioButtonGroup.SelectedValue="{Binding ViewState}">

                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <RadioButton
                            Content="{Binding Title}"
                            Value="{Binding Value}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>

                </HorizontalStackLayout>

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,20" />

                <!-- Preview -->
                <Label Text="Preview:" FontSize="16" FontAttributes="Bold" Margin="0,0,0,10" />

                <Border StrokeThickness="2"
                Stroke="LightGray"
                Padding="20"
                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2E2E2E}">
                    <ContentPresenter/>
                </Border>

            </VerticalStackLayout>
        </ContentView>
    </ControlTemplate>
</ResourceDictionary>