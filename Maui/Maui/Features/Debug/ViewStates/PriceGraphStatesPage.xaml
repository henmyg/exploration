<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Features.Debug.ViewStates.PriceGraphStatesPage"
             xmlns:features="clr-namespace:Maui.Features"
             xmlns:viewStates="clr-namespace:Maui.Features.Debug.ViewStates"
             xmlns:priceGraph="clr-namespace:Maui.Features.PriceGraph"
             xmlns:vm="clr-namespace:Maui.Core.Features.Debug;assembly=Maui.Core"
             Title="PriceGraphStatesPage">
    <ContentPage.BindingContext>
        <features:Locator ViewModelType="{x:Type vm:PriceGraphStatesViewModel}" />
    </ContentPage.BindingContext>
    <ContentPage.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <viewStates:PreviewTemplate />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">
            <ContentView
                ControlTemplate="{StaticResource PreviewView}">
                <priceGraph:PriceGraphView BindingContext="{Binding}" />
            </ContentView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>