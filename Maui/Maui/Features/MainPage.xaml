<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:features="clr-namespace:Maui.Core.Features;assembly=Maui.Core"
             xmlns:syncStatus="clr-namespace:Maui.Features.SyncStatus"
             xmlns:currentPrice="clr-namespace:Maui.Features.CurrentPrice"
             xmlns:priceGraph="clr-namespace:Maui.Features.PriceGraph"
             x:Class="Maui.Features.MainPage"
             x:DataType="features:MainPageModel"
             Title="MainPage">
    <VerticalStackLayout>
        <syncStatus:SyncStatusView BindingContext="{Binding SyncStatus}" />
        <currentPrice:CurrentPriceView BindingContext="{Binding CurrentPrice}"/>
        <priceGraph:PriceGraphView BindingContext="{Binding PriceGraph}"/>
    </VerticalStackLayout>
</ContentPage>