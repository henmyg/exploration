<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:syncStatus="clr-namespace:Maui.Core.Features.SyncStatus;assembly=Maui.Core"
             x:Class="Maui.Features.SyncStatus.SyncStatusView"
             x:DataType="syncStatus:SyncStatusViewModel">
    <VerticalStackLayout>
        <HorizontalStackLayout HorizontalOptions="Center">
            <Label 
                Text="{Binding SyncText}"
                FontSize="16"
                />
        </HorizontalStackLayout>
    </VerticalStackLayout>
</ContentView>
