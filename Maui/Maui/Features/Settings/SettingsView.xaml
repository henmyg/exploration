<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:locator="clr-namespace:Maui.Features"
             xmlns:vm="clr-namespace:Maui.Core.Features.Settings;assembly=Maui.Core"
             x:Class="Maui.Features.Settings.SettingsView"
             x:DataType="vm:ISettingsViewModel">
    <ContentView.BindingContext>
        <locator:Locator ViewModelType="{x:Type vm:ISettingsViewModel}" />
    </ContentView.BindingContext>
    <VerticalStackLayout>
        <Label
            Text="{Binding Title}" />
        <Button
            Text="Configuration"
            Command="{Binding GoToConfigurationCommand}" />
    </VerticalStackLayout>
</ContentView>
