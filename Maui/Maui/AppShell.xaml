<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:features="clr-namespace:Maui.Features"
    xmlns:settings="clr-namespace:Maui.Features.Settings"
    Title="Maui">

    <TabBar>
        <ShellContent
            Route="Today"
            Title="Today"
            Icon="home.png"
            ContentTemplate="{DataTemplate features:TodayPage}" />

        <ShellContent
            Route="Settings"
            Title="Settings"
            Icon="settings.png"
            ContentTemplate="{DataTemplate settings:SettingsPage}" />
    </TabBar>

</Shell>
